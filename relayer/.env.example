# Source chain (where EconomicEvents.sol / a merchant's real payment rail lives)
SOURCE_CHAIN_RPC_URL=
SOURCE_CHAIN_KEY=
ECONOMIC_EVENTS_ADDRESS=

# Creditcoin
CREDITCOIN_RPC_URL=
CREDITCOIN_PROOF_BUILDER_URL=
ATTESTCOIN_VERIFIER_ADDRESS=

# Relayer's own signing key. Use a DEDICATED TESTNET WALLET — never a mainnet key, never
# committed. The relayer submits evidence transactions; it never custodies borrower or LP funds.
PRIVATE_KEY=

# Retry tuning (optional — sane defaults in src/config.ts)
MAX_RETRIES=5
BASE_BACKOFF_MS=2000
MAX_BACKOFF_MS=60000

# Health server port (optional)
HEALTH_PORT=8787
